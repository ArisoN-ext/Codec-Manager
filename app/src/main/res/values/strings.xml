    <!-- Onboarding -->
    <string name="onboarding_title_1">Sound without compromise</string>
    <string name="onboarding_body_1">Codec Manager switches your headphones to the best LDAC quality whenever they connect.</string>
    <string name="onboarding_title_2">Codec access, the right way</string>
    <string name="onboarding_body_2">Android only allows apps associated with your headphones through the Companion Device Manager to change the codec. No root required.</string>
    <string name="onboarding_title_3">Associate your headphones</string>
    <string name="onboarding_body_3">Pick a paired device and confirm the system prompt. You only need to do this once per device.</string>
    <string name="onboarding_title_4">You are all set</string>
    <string name="onboarding_body_4">On connection the app applies your profile and verifies the result. If something goes wrong, diagnostics will tell you why.</string>
